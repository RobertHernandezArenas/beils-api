{
	"compilerOptions": {
		"moduleResolution": "bundler",
		"module": "ESNext",
		"target": "ES2023",
		"strict": true,
		"esModuleInterop": true,
    "ignoreDeprecations": "5.0",
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./api/*"],
			"@components/*": ["./api/components/*"],
      "@user": ["./api/components/User/*"],
			"@config/*": ["./api/config/*"],
			"@orm/*": ["./api/config/database/orm/*"],
			"@router/*": ["./api/router/*"],
		},
		"outDir": "dist/",
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true
	},
	"include": ["api/**/*", "api/database/prisma"]
}
